# Load these explicitly in your shell or hosting environment. Never commit actual values.
AGENT_DATABASE_URL=
# Existing Wrytely Clerk instance's issuer and PEM public key. No new Clerk app needed.
AGENT_CLERK_ISSUER=
AGENT_CLERK_JWT_KEY=
AGENT_AUTHORIZED_PARTIES=["http://localhost:3000","https://agent.wrytely.io"]
AGENT_META_API_KEY=
AGENT_META_MODEL=muse-spark-1.3
AGENT_MAX_EPISODE_TURNS=6
AGENT_LEASE_SECONDS=300
AGENT_MAX_ATTEMPTS=3
AGENT_PENDING_TASK_LIMIT=20
# Tests must use an isolated, disposable database, never Wrytely production.
AGENT_TEST_DATABASE_URL=

# Official WhatsApp Cloud API webhook configuration. Keep disabled until setup.
AGENT_WHATSAPP_APP_SECRET=
AGENT_WHATSAPP_VERIFY_TOKEN=
AGENT_WHATSAPP_PHONE_NUMBER_ID=
AGENT_WHATSAPP_BUSINESS_ACCOUNT_ID=

# Canvas collection is disabled until an operator selects exact approved origins
# and trusted local converters. These examples contain no credentials.
AGENT_CANVAS_ORIGINS=[]
AGENT_CANVAS_DOCUMENT_EXTRACTORS=[]
# P1 isolated test example, after approval:
# AGENT_CANVAS_ORIGINS=["https://colostate.instructure.com"]
# AGENT_CANVAS_DOCUMENT_EXTRACTORS=["canvas.html.v1","canvas.json.v1","canvas.text.v1","canvas.pdf.v1"]
